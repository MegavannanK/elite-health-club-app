DATABASE_URL=postgresql://ehc:local-dev-password@localhost:5433/elitehealthclub
JWT_SECRET=local-only-change-this-secret-before-production-123456
JWT_ISSUER=elitehealthclub
JWT_AUDIENCE=elitehealthclub-api
CORS_ORIGINS=["http://localhost:3000"]
MAX_ADVANCE_DAYS=365
TEST_DATABASE_URL=postgresql://ehc:local-dev-password@localhost:5433/elitehealthclub_test

# Clerk is the default. Use development ONLY for local booking demos/tests.
AUTH_MODE=clerk
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
# Native Clerk sessions may omit azp. Enable only if supporting those clients.
CLERK_ALLOW_MISSING_AZP=false
ZOHO_ACCOUNT_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_WEBHOOK_SECRET=
# Enable later when payment validation is ready. Clerk sign-in stays required.
PAYMENT_VALIDATION_ENABLED=false
PAYMENT_REFRESH_SECONDS=300
# Default plan prices are defined in app/config.py. Until validity_days is
# approved/configured, successful payments are classified but access is review.
# PLAN_POLICIES={"individual":{"user_type":"member","amount":"82600.00","validity_days":1826},"family":{"user_type":"member","amount":"236000.00","validity_days":1826},"early_bird":{"user_type":"guest","amount":"2000.00","validity_days":1}}
# validity_days starts at Zoho paid date; example durations above are NOT club policy.
